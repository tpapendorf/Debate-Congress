{
  "name": "debate-congress",
  "version": "0.1.0",
  "private": true,
  "description": "Web app for running a high school Congressional Debate chamber: logins by role, live floor with PO precedence, timers, motions and votes, and private judge scoring.",
  "main": "server/index.js",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^4.22.3"
  }
}
